CompileFlags:
  # All four CMake presets (see CMakePresets.json) use the same binaryDir,
  # so this is correct regardless of which one was last configured -
  # linux-cross-{debug,release} or windows-{debug,release}.
  CompilationDatabase: build

  # Belt-and-suspenders on top of that database: these paths get appended
  # to *every* file clangd compiles, including one with no compile command
  # of its own (a header with no same-named .cpp to borrow flags from, or
  # any file opened before background-indexing has found one) - cases
  # where clangd otherwise falls back to a generic guess with none of
  # this project's include paths at all. That's what was causing
  # <soup/...>, <fmt/...>, etc. to intermittently fail to resolve: CMake
  # already puts every path below on the Stand target's real compile
  # commands (see CMakeLists.txt), but that only helps a file that
  # actually gets one.
  #
  # Relative paths here resolve relative to this .clangd file itself (the
  # repo root), the same on Windows and Linux - no OS-specific paths
  # needed for this part.
  Add:
    # Every subfolder under src/ that has a header in it (Core/, Game/,
    # Commands/Vehicle/, etc.) is on the real compile commands already
    # (see STAND_INCLUDE_DIRS in CMakeLists.txt) - this is just the root,
    # for same-directory/top-level lookups.
    - -Isrc

    # src/lib/ itself - what makes `#include <soup/Rgb.hpp>`,
    # `#include "soup/Uri.hpp"`, `#include <discord-rpc/include/discord_rpc.h>`
    # and `#include <souplua/soup_lua_bindings.hpp>` resolve (each vendored
    # library is reached qualified with its own directory name, rather
    # than adding every vendored library's own directory to the search
    # path - see the comment on LIB_DIR in CMakeLists.txt for why, and
    # crucially, why soup/ itself is deliberately NOT also added).
    - -Isrc/lib

    # The vendored libraries whose own headers are reached bare (no
    # library-name prefix), matching how each one's
    # target_include_directories() exposes it in CMakeLists.txt.
    - -Isrc/lib/pluto
    - -Isrc/lib/fmt/include
    - -Isrc/lib/rapidjson/include
    - -Isrc/lib/minhook/include
    - -Isrc/lib/directxtk/Inc

Diagnostics:
  # This codebase leans on a shared precompiled header (src/Core/common.hpp)
  # to pull in most of what any given file needs, and on the vendored
  # libraries under src/lib/ having their own established include style.
  # clangd's IncludeCleaner would otherwise flag a lot of headers as
  # "missing" (reached transitively through the PCH) or "unused" (kept for
  # a symbol IncludeCleaner doesn't attribute to it) that aren't actually
  # either - so both are turned off rather than fought file by file.
  UnusedIncludes: None
  MissingIncludes: None
